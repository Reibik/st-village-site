{
    email admin@stvillage.ru
    servers {
        protocols h1 h2 h3
    }
}

(security_headers) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Permitted-Cross-Domain-Policies "none"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://telegram.org https://*.telesco.pe; font-src 'self' data:; connect-src 'self' https://cabinet.stvillage.top https://t.me; upgrade-insecure-requests"
    }
}

stvillage.top {
    import security_headers
    encode zstd gzip

    @review_moderation_page path /reviews/moderation*
    basic_auth @review_moderation_page {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @review_moderation_api {
        path /api/reviews
        method PATCH DELETE
    }
    basic_auth @review_moderation_api {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @review_queue_api {
        path /api/reviews
        query status=*
    }
    basic_auth @review_queue_api {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @status_management path /status/management* /api/admin/*
    basic_auth @status_management {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @status_analytics {
        path /api/analytics
        method GET
    }
    basic_auth @status_analytics {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @status_management_write {
        path /api/incidents
        method POST
    }
    basic_auth @status_management_write {
        {$ST_VILLAGE_ADMIN_AUTH_USER} {$ST_VILLAGE_ADMIN_AUTH_HASH}
    }

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @dynamic path /api/*
    header @dynamic {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, nosnippet"
    }

    @brand_assets path /og-social-v2.png /icon-192.png /icon-512.png /apple-touch-icon.png /favicon.ico /favicon.svg
    header @brand_assets Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

    reverse_proxy 127.0.0.1:3000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    log {
        output file /var/log/caddy/st-village.log {
            roll_size 10mb
            roll_keep 10
            roll_keep_for 720h
        }
    }
}

dev.stvillage.ru {
    encode zstd gzip

    route {
        import security_headers

        header {
            Cache-Control "no-store"
            X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
            X-ST-Village-Environment "development"
        }

        basic_auth {
            {$ST_VILLAGE_DEV_AUTH_USER} {$ST_VILLAGE_DEV_AUTH_HASH}
        }

        @robots path /robots.txt
        respond @robots "User-agent: *\nDisallow: /\n" 200

        reverse_proxy 127.0.0.1:3001 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }

    log {
        output file /var/log/caddy/st-village-dev.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 168h
        }
    }
}

stvillage.ru, www.stvillage.ru {
    redir https://stvillage.top{uri} permanent
}

st-villagevpn.ru, www.st-villagevpn.ru {
    redir https://stvillage.top{uri} permanent
}

# Public base URL used for canonical, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://stvillage.top
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Public Bedolaga Cabinet landing API. No API token is required.
BEDOLAGA_API_URL=https://cabinet.stvillage.top/api
BEDOLAGA_LANDING_SLUG=st-village

# Optional persistence.
DATABASE_URL=

# Remnawave is called only by the server. Store the token as a server secret.
REMNAWAVE_BASE_URL=https://panel.stvillage.ru
REMNAWAVE_API_TOKEN=
REMNAWAVE_NODES_PATH=/api/nodes

# Public service probes. Telegram URL checks the public page, not the bot process.
STATUS_CABINET_URL=https://cabinet.stvillage.top
STATUS_TELEGRAM_URL=https://t.me/st_village_vpn_bot
STATUS_BOT_HEALTHCHECK_URL=
STATUS_PROBE_TIMEOUT_MS=4000

# Optional administrator alerts. The same bot also sends new reviews to moderation.
STATUS_ALERT_TELEGRAM_BOT_TOKEN=
STATUS_ALERT_TELEGRAM_CHAT_ID=
STATUS_REGIONAL_CHECKS_DISABLED=0
STATUS_PUBLIC_SITE_URL=https://stvillage.top
OBSERVABILITY_FILE_PATH=

# Token for opening /reviews/moderation and approving or rejecting reviews.
REVIEWS_ADMIN_TOKEN=
STATUS_ADMIN_TOKEN=
RATE_LIMIT_SECRET=

# Signed API access for the website-only Telegram administration module.
# Generate a random token (at least 32 bytes) and list allowed Telegram user IDs.
SITE_BOT_API_TOKEN=
SITE_BOT_ADMIN_IDS=

# Configure real locations in the hosting environment, not in this tracked sample.
# probeUrl and remnawaveUuid are never returned to clients.
# Example: [{"id":"nl-1","code":"NL","name":"Нидерланды","region":"Западная Европа","probeUrl":"https://status-node.example/health","remnawaveUuid":"..."}]
STATUS_LOCATIONS_JSON=

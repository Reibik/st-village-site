{
  "name": "st-village",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:links": "node scripts/check-client-links.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker",
    "typecheck": "tsc --noEmit --pretty false",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test:performance && pnpm build && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
